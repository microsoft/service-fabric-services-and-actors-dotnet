<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local packages for Service Fabric references -->
    <add key="ServiceFabric_NugetPackages_LocalPath" value="refs" />
  </packageSources>
  <config>
    <add key="repositoryPath" value="nuget\restored_packages" />
  </config>
</configuration>
